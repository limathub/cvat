# Copy to .env and edit (file is gitignored). Used by Docker Compose and customization scripts.
#
#   cp .env.example .env

# --- Docker Compose / Traefik (hostname only, no scheme or port) ---
CVAT_HOST=localhost

# --- Customization Python scripts (full REST base URL) ---
# If unset, scripts use CVAT_HOST and add http:// and :8080 when needed.
CVAT_API_URL=http://localhost:8080

CVAT_USER=admin
CVAT_PASSWORD=changeme
# CVAT_ACCESS_TOKEN=   # optional; overrides user/password when set

# Optional compose overlays (uncomment as needed)
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
